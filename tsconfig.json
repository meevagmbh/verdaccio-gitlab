{
  "compilerOptions": {
    "target": "esnext",
    // CommonJS output for verdaccio's require(); node20 models Node's
    // require() of ESM-only packages such as @gitbeaker/rest.
    "module": "node20",
    "strict": true,
    // Some verdaccio packages reference types they do not depend on
    // (express, http-errors); do not type-check other packages' .d.ts files.
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "build"
  },
  "include": ["src/*.ts"]
}
