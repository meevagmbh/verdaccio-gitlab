{
  "name": "verdaccio-gitlab",
  "author": {
    "name": "Roger Meier",
    "email": "roger@bufferoverflow.ch"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "license": "license-checker-rseidelsohn --onlyAllow 'Apache-2.0; Apache License, Version 2.0; BlueOak-1.0.0; BSD; BSD-2-Clause; BSD-3-Clause; ISC; MIT; Unlicense; WTFPL; CC-BY-3.0; CC0-1.0' --production --summary",
    "type-check:watch": "npm run type-check -- --watch",
    "lint:ts": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "yarn type-check && yarn lint:ts && markdownlint README.md",
    "postinstall": "husky || true",
    "prepack": "rimraf build && yarn lint && yarn code:build && pinst --disable",
    "postpack": "pinst --enable",
    "release:major": "scripts/release.sh major",
    "release:minor": "scripts/release.sh minor",
    "release:patch": "scripts/release.sh patch",
    "start": "yarn code:build && cross-env NODE_PATH=${NODE_PATH:-}:.. node build/verdaccio.js",
    "code:build": "tsc",
    "code:docker-build": "tsc",
    "build:docker": "docker build -t verdaccio-gitlab . --no-cache",
    "test": "yarn test:unit",
    "test:unit": "cross-env TZ=UTC vitest run --config ./test/vitest.config.unit.mts --maxWorkers 2",
    "test:functional": "cross-env TZ=UTC vitest run --config ./test/vitest.config.functional.mts --passWithNoTests",
    "test:all": "yarn test && yarn test:functional"
  },
  "main": "build/index.js",
  "files": [
    "bin/",
    "build/*.js"
  ],
  "version": "3.0.1",
  "description": "private npm registry (Verdaccio) using gitlab-ce as authentication and authorization provider",
  "keywords": [
    "sinopia",
    "verdaccio",
    "gitlab",
    "auth",
    "npm",
    "registry",
    "npm-registry"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meevagmbh/verdaccio-gitlab.git"
  },
  "homepage": "https://github.com/meevagmbh/verdaccio-gitlab",
  "bugs": {
    "url": "https://github.com/meevagmbh/verdaccio-gitlab/issues"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "dependencies": {
    "@gitbeaker/requester-utils": "44.0.5",
    "@gitbeaker/rest": "44.0.5",
    "@verdaccio/core": "8.4.0",
    "lru-cache": "11.5.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "24.19.2",
    "@verdaccio/types": "13.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "body-parser": "^2.4.0",
    "chalk": "6.0.1",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "husky": "9.1.7",
    "kleur": "4.1.5",
    "license-checker-rseidelsohn": "5.0.1",
    "lint-staged": "17.6.0",
    "lodash": "^4.18.1",
    "markdownlint-cli": "^0.50.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "pinst": "3.0.0",
    "prettier": "3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "7.0.2",
    "verdaccio": "6.11.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,mjs,mts,ts}": "oxlint --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
